{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematic-studio.local/schemas/hardware_profile.schema.json",
  "title": "Cinematic Studio Hardware Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "fingerprint", "system", "memory", "gpus", "storage", "media", "software", "benchmarks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": "string", "minLength": 16},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture", "cpu_model", "physical_cores", "logical_cores"],
      "properties": {
        "os": {"type": "string"},
        "os_version": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu_model": {"type": "string"},
        "physical_cores": {"type": "integer", "minimum": 1},
        "logical_cores": {"type": "integer", "minimum": 1},
        "instruction_sets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "power_mode": {"type": ["string", "null"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ram_total_bytes", "ram_available_bytes"],
      "properties": {
        "ram_total_bytes": {"type": "integer", "minimum": 0},
        "ram_available_bytes": {"type": "integer", "minimum": 0},
        "swap_total_bytes": {"type": "integer", "minimum": 0},
        "swap_available_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "vendor", "name", "vram_total_bytes", "vram_free_bytes", "driver", "backends", "precisions"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "vendor": {"type": "string"},
          "name": {"type": "string"},
          "device_id": {"type": ["string", "null"]},
          "vram_total_bytes": {"type": "integer", "minimum": 0},
          "vram_free_bytes": {"type": "integer", "minimum": 0},
          "largest_safe_allocation_bytes": {"type": ["integer", "null"], "minimum": 0},
          "driver": {"type": "string"},
          "compute_capability": {"type": ["string", "null"]},
          "backends": {"type": "array", "items": {"enum": ["cuda", "rocm", "directml", "vulkan", "metal", "oneapi"]}, "uniqueItems": true},
          "precisions": {"type": "array", "items": {"enum": ["fp32", "tf32", "fp16", "bf16", "fp8", "int8", "int4"]}, "uniqueItems": true},
          "peer_devices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
        }
      }
    },
    "storage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "filesystem", "total_bytes", "free_bytes"],
        "properties": {
          "role": {"enum": ["application", "projects", "models", "cache", "temporary"]},
          "path": {"type": "string"},
          "filesystem": {"type": "string"},
          "total_bytes": {"type": "integer", "minimum": 0},
          "free_bytes": {"type": "integer", "minimum": 0},
          "read_mbps": {"type": ["number", "null"], "minimum": 0},
          "write_mbps": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg_version", "ffprobe_version", "encoders", "decoders"],
      "properties": {
        "ffmpeg_version": {"type": ["string", "null"]},
        "ffprobe_version": {"type": ["string", "null"]},
        "encoders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decoders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "ten_bit_supported": {"type": "boolean"},
        "max_tested_width": {"type": ["integer", "null"], "minimum": 1},
        "max_tested_height": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]},
      "properties": {
        "application_version": {"type": "string"},
        "python_version": {"type": ["string", "null"]},
        "torch_version": {"type": ["string", "null"]},
        "cuda_runtime": {"type": ["string", "null"]},
        "openusd_version": {"type": ["string", "null"]},
        "blender_version": {"type": ["string", "null"]}
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matrix_fp16_tflops": {"type": ["number", "null"], "minimum": 0},
        "matrix_bf16_tflops": {"type": ["number", "null"], "minimum": 0},
        "vae_decode_fps": {"type": ["number", "null"], "minimum": 0},
        "encode_1080p_fps": {"type": ["number", "null"], "minimum": 0},
        "encode_4k_fps": {"type": ["number", "null"], "minimum": 0},
        "worker_start_ms": {"type": ["number", "null"], "minimum": 0},
        "multi_gpu_transfer_gbps": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}