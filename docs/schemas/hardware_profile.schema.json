{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematic.studio/schemas/hardware_profile.schema.json",
  "title": "Cinematic Studio Hardware Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "fingerprint", "system", "memory", "gpus", "storage", "media", "software", "benchmarks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": "string", "minLength": 16},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "cpu", "logical_cores", "physical_cores"],
      "properties": {
        "os": {"type": "string"},
        "os_version": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu": {"type": "string"},
        "logical_cores": {"type": "integer", "minimum": 1},
        "physical_cores": {"type": "integer", "minimum": 1},
        "instruction_sets": {"type": "array", "items": {"type": "string"}},
        "power_mode": {"type": ["string", "null"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ram_bytes", "available_ram_bytes"],
      "properties": {
        "ram_bytes": {"type": "integer", "minimum": 0},
        "available_ram_bytes": {"type": "integer", "minimum": 0},
        "swap_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vendor", "name", "vram_bytes", "available_vram_bytes", "driver", "backends", "precisions"],
        "properties": {
          "id": {"type": "string"},
          "vendor": {"enum": ["nvidia", "amd", "intel", "apple", "other"]},
          "name": {"type": "string"},
          "vram_bytes": {"type": "integer", "minimum": 0},
          "available_vram_bytes": {"type": "integer", "minimum": 0},
          "largest_safe_allocation_bytes": {"type": ["integer", "null"], "minimum": 0},
          "driver": {"type": "string"},
          "compute_capability": {"type": ["string", "null"]},
          "backends": {"type": "array", "items": {"enum": ["cuda", "rocm", "directml", "vulkan", "metal", "cpu"]}},
          "precisions": {"type": "array", "items": {"enum": ["fp32", "tf32", "fp16", "bf16", "fp8", "int8", "int4"]}},
          "peer_devices": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "free_bytes", "filesystem"],
        "properties": {
          "path": {"type": "string"},
          "free_bytes": {"type": "integer", "minimum": 0},
          "total_bytes": {"type": "integer", "minimum": 0},
          "filesystem": {"type": "string"},
          "read_mib_s": {"type": ["number", "null"], "minimum": 0},
          "write_mib_s": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg", "ffprobe", "encoders", "decoders"],
      "properties": {
        "ffmpeg": {"type": ["string", "null"]},
        "ffprobe": {"type": ["string", "null"]},
        "encoders": {"type": "array", "items": {"type": "string"}},
        "decoders": {"type": "array", "items": {"type": "string"}},
        "verified_4k_encoders": {"type": "array", "items": {"type": "string"}}
      }
    },
    "software": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_gemm_tflops": {"type": ["number", "null"], "minimum": 0},
        "vae_decode_fps": {"type": ["number", "null"], "minimum": 0},
        "encode_1080p_realtime_factor": {"type": ["number", "null"], "minimum": 0},
        "encode_4k_realtime_factor": {"type": ["number", "null"], "minimum": 0},
        "worker_start_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "recommendations": {"type": "object", "additionalProperties": true}
  }
}
