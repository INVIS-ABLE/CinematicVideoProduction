{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wan Cognitive Fabric Storyboard",
  "description": "Complete film plan consumed by wan/cognitive_fabric/pipeline/storyboard_orchestrator.py. See docs/STORYBOARD_FORMAT.md for a worked example.",
  "type": "object",
  "required": ["project", "shots"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string"},
        "duration_minutes": {"type": "number"},
        "duration_seconds": {"type": "number"},
        "style": {"type": "string"},
        "anime_mode": {"type": "boolean"},
        "aspect_ratio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "2.35:1", "4:5"]},
        "base_resolution": {"type": "string"},
        "final_resolution": {"type": "string"},
        "frame_rate": {"type": "integer"},
        "master_frame_rate": {"type": "integer"}
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "name"],
        "properties": {
          "character_id": {"type": "string"},
          "name": {"type": "string"},
          "face_description": {"type": "string"},
          "wardrobe_description": {"type": "string"},
          "colour_palette": {"type": "string"},
          "continuity_rules": {"type": "array", "items": {"type": "string"}},
          "reference_assets": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "name"],
        "properties": {
          "object_id": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "material": {"type": "string"},
          "colour": {"type": "string"},
          "damage_state": {"type": "string"}
        }
      }
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["world_id"],
        "properties": {
          "world_id": {"type": "string"},
          "description": {"type": "string"},
          "location_type": {"type": "string"},
          "time_of_day": {"type": "string"},
          "weather": {"type": "string"},
          "light_direction": {"type": "string"}
        }
      }
    },
    "acts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["act_id"],
        "properties": {
          "act_id": {"type": "string"},
          "scenes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id"],
        "properties": {
          "scene_id": {"type": "string"},
          "act_id": {"type": "string"},
          "world_id": {"type": "string"},
          "purpose": {"type": "string"},
          "emotional_beat": {"type": "string"},
          "shots": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "scene_id", "duration_seconds", "prompt"],
        "properties": {
          "shot_id": {"type": "string"},
          "scene_id": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "prompt": {"type": "string"},
          "negative_prompt": {"type": "string"},
          "shot_type": {"type": "string"},
          "character_ids": {"type": "array", "items": {"type": "string"}},
          "object_ids": {"type": "array", "items": {"type": "string"}},
          "world_id": {"type": ["string", "null"]},
          "camera_plan": {"type": "object"},
          "lighting_plan": {"type": "object"},
          "motion_plan": {"type": "object"},
          "physics_expectation": {"type": "object"},
          "transition_in": {"type": "string"},
          "transition_out": {"type": "string"},
          "audio_reference": {"type": ["string", "null"]},
          "style_reference": {"type": ["string", "null"]},
          "continuity_from_previous": {"type": "boolean"},
          "continuity_to_next": {"type": "boolean"},
          "seed_strategy": {"type": "string", "enum": ["fixed", "per_shot", "per_chunk"]},
          "output_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
